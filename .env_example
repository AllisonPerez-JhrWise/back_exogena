# ── App ──────────────────────────────────────────────────────────────
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# ── Base de datos local en docker (docker-compose.yml) ───────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exogena
POSTGRES_PORT=5433

# ── Base de datos ─────────────────────────────────────────────────────────
# Se requiere el driver async (postgresql+asyncpg://)
# Dentro de docker compose el host es "db"; desde tu máquina usa localhost:5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/exogena
# AWS RDS: inyectar DATABASE_URL desde Secrets Manager (nunca subirla al repo) y poner
# DB_SSL_MODE=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# ── Autenticación ─────────────────────────────────────────────────────────────
# Mínimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# true en todo entorno HTTPS (obligatorio en producción)
COOKIE_SECURE=false
# COOKIE_DOMAIN=.jhrwise.com

# ── Front-end (Next.js) ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (opcional: dejar vacío para deshabilitarlo) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
