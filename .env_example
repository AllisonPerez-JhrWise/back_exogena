# ── App ──────────────────────────────────────────────────────────────
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# ── Base de datos local en docker (docker-compose.yml) ───────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exogena
POSTGRES_PORT=5433

# ── Base de datos (por partes, como en todos los servicios: AjustesBase de wise-comun) ──
# Dentro de docker compose el host es "db"; desde tu máquina usa localhost:5433
# Los usuarios son los mismos de la RDS (ver docker/db-init/00_roles.sql):
#   DB_USER        con el que corre la app (wiseerp_app: funciones app_* y seguridad por filas)
#   DB_ADMIN_USER  dueño del schema exogena, corre las migraciones (en AWS: allison_brinez)
DB_HOST=db
DB_PORT=5432
DB_NAME=exogena
DB_USER=wiseerp_app
DB_PASSWORD=wiseerp_app
DB_ADMIN_USER=exogena_dev
DB_ADMIN_PASSWORD=exogena_dev
# disable en local; require en AWS RDS
DB_SSLMODE=disable
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# ── Cognito e Identidad (wise-comun) ────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-2_ncrvMH8Xu
COGNITO_CLIENT_ID=6ef1f308g4h93orrcf4ff3b63p
# Dirección del servicio de identidad (wise-auth). Vacía mientras no se use
IDENTIDAD_URL=

# ── Autenticación ─────────────────────────────────────────────────────────────
# PROVISIONAL hasta integrar Cognito (el login lo hace la plataforma).
# Mínimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# SOLO PRUEBAS LOCALES mientras llegan Cognito y el tenant: sin token ni X-Tenant-Id la API
# responde igual, muestra todo y no revisa permisos. Si se envían, se validan normalmente.
# La app no arranca con esto en true si ENVIRONMENT=production.
AUTH_BYPASS=true
# Firma que se usa cuando no llega X-Tenant-Id (la que crea `make seed`)
DEV_TENANT_ID=00000000-0000-4000-8000-00000000f1a0

# ── Front-end (Next.js) ──────────────────────────────────────────────
# Host (3000) y microfront de Exógena (3001): el navegador llama la API directamente
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
